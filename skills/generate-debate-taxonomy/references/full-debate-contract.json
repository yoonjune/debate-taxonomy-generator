{
  "contract_version": "0.2",
  "language": "en",
  "roles": [
    "MOD",
    "PRO",
    "CON"
  ],
  "phase_order": [
    1,
    2,
    3
  ],
  "required_taxonomies": [
    "A3-1",
    "A3-2"
  ],
  "allowed_taxonomies": [
    "A1",
    "A2-1",
    "A2-2",
    "A3-1",
    "A3-2",
    "A4",
    "A5",
    "B1",
    "B2"
  ],
  "taxonomy_count_per_sample": {
    "min": 3,
    "max": 5
  },
  "profiles": {
    "short": {
      "total_duration_sec": {
        "min": 210,
        "max": 225
      },
      "phase2_duration_sec": {
        "min": 65,
        "max": 80
      }
    },
    "long": {
      "total_duration_sec": {
        "min": 300,
        "max": 330
      },
      "phase2_duration_sec": {
        "min": 150,
        "max": 180
      }
    }
  },
  "timing": {
    "moderator_intro_sec": {
      "min": 8,
      "max": 20
    },
    "speech_limit_sec": 30,
    "time_cue_remaining_sec": 10,
    "time_cue_required_above_sec": 20,
    "in_time_speech_sec": {
      "min": 8,
      "max": 30
    },
    "overrun_speech_sec": {
      "min": 30,
      "max": 45
    },
    "max_a5_interrupt_words": 12,
    "max_pro_con_duration_ratio": 1.15,
    "max_words_per_turn": 100,
    "max_moderator_word_share": 0.25,
    "time_cue_lands_at_sec": 20,
    "max_coded_moderator_turns": 8
  },
  "content": {
    "audience_speakers_allowed": false,
    "routine_moderator_questions_allowed": false,
    "phase3_first_debater": "PRO",
    "announce_rules_in_intro": true,
    "unfinished_turn_marker": "-",
    "moderator_may_reference_only_transcript": true,
    "debater_may_not_echo_moderator_turn": true,
    "no_self_reference_in_third_person": true,
    "no_consecutive_duplicate_turns": true,
    "round_wording_must_match_phase": true,
    "cutoff_lines_must_mention_time": true,
    "a3_2_must_announce_round_end": true,
    "accused_speaker_replies_first_after_B1_B2": true,
    "A2_2_text_only_gradable": false
  },
  "overlap": {
    "codes_that_overlap": [
      "A1",
      "A2-1",
      "A3-2",
      "A4",
      "A5"
    ],
    "codes_that_do_not_overlap": [
      "A2-2",
      "A3-1"
    ],
    "require_overlap_with": true,
    "note": "an overlapping moderator turn must name the turn it cuts into so synthesis can place the voices on top of each other. the exact gap in seconds is decided at synthesis time, not here."
  },
  "preconditions": {
    "A1": {
      "requires_time_cue_on_same_speaker": true,
      "requires_unfinished_trigger": true,
      "requires_no_next_speaker_in_phase": true
    },
    "A2-1": {
      "requires_time_cue_on_same_speaker": true,
      "requires_unfinished_trigger": true
    },
    "A3-2": {
      "requires_unfinished_trigger": true
    },
    "A4": {
      "max_moderator_words": 12,
      "same_speaker_continues_after": true,
      "must_state_ten_seconds": true
    },
    "A5": {
      "phases": [
        1,
        3
      ],
      "addressee": "interrupter_to_stop_or_floor_holder_to_continue",
      "must_not_grant_floor_to_interrupter": true
    },
    "B1": {
      "phases": [
        2
      ],
      "drift_starts_from_own_prior_point": true,
      "drift_spans_whole_turn": true
    },
    "B2": {
      "phases": [
        2
      ],
      "contradiction_test": [
        "same subject",
        "same conditions",
        "same period",
        "same standard",
        "cannot both be true"
      ],
      "shape": "broad_rule_then_exception",
      "requires_reconciling_turn_after": true,
      "must_not_be_direct_reversal": true,
      "seed_must_quote_both_claims": true
    }
  },
  "evaluation": {
    "probe_design": "feed the transcript up to just before a moderator moment and ask: should the moderator speak here, and doing what?",
    "balanced_probes_per_sample": true,
    "negative_controls_required": [
      "near_limit_speech_not_cut",
      "brief_drift_that_self_corrects",
      "compatible_claims_that_sound_opposed",
      "crossfire_interruption_left_alone"
    ],
    "boundary_speech_sec": {
      "min": 28,
      "max": 30
    }
  }
}
